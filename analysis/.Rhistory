library(ggplot2)
library(boot)
library(faraway)
library(MASS)
library(leaps)
# Use this code chunk for your calculation, if needed.
bechdel <- read.csv('./bechdel.csv')
head(bechdel)
glm3 <- glm(pass ~ year, data=bechdel, family = binomial)
summary(glm3)
glm4a <- glm(pass ~ . - pass - title, data=bechdel, family = 'binomial')
summary(glm4a)
anova(glm3, glm4a, test='LRT')
modc <- stepAIC(glm4a, direction = "backward", k=log(nrow(bechdel)))
anova(glm4a, modc)
glm6 <- glm(pass ~ imdb_rating + budget_2013, data=bechdel, family='binomial')
summary(glm6)
new_obs <- data.frame(budget_2013 = 6000000, imdb_rating = 6)
predicted <- predict(glm6, new_obs, se.fit=T, type='link')
predicted$fit + c(-1, 1)*1.96*predicted$se.fit
newdata <- read.csv('./bechdel_test.csv')
predicted2 <- predict(glm6, newdata=newdata, type='response')
predicted_class <- predicted2 > 0.7
table(predicted=predicted_class, actual=newdata$pass)
